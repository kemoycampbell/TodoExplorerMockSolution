<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:TodoExploerProject.Converters"
             x:Class="TodoExploerProject.MainPage">
    
    <ContentPage.Resources>
        <converters:FavoriteIconConverter x:Key="FavoriteIconConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Header -->
            <VerticalStackLayout Spacing="3">

                <Label Text="Todo Explorer"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#006C70"/>

                <Label Text="Manage your todos and favorites"
                       FontSize="16"
                       TextColor="#666666"/>

            </VerticalStackLayout>

            <!-- Actions -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">

                <Button Grid.Column="0"
                        Text="🔄 Reload Todos"
                        Command="{Binding ReloadTodosCommand}"
                        BackgroundColor="#006C70"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontAttributes="Bold"/>
                
                <Button Grid.Column="1"
                        Text="♥ Favorites"
                        Command="{Binding FavoritesNavPageCommand}"
                        BackgroundColor="White"
                        TextColor="#006C70"
                        BorderColor="#006C70"
                        BorderWidth="1"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontAttributes="Bold"/>

            </Grid>

